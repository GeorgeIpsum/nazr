terraform {
  required_version = ">= 1.9"

  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 6.0"
    }
    acme = {
      source  = "vancluever/acme"
      version = "~> 3.2"
    }
    random = {
      source  = "hashicorp/random"
      version = "~> 3.0"
    }
    tls = {
      source  = "hashicorp/tls"
      version = "~> 4.0"
    }
  }
}

# No provider blocks here: the nazr module configures the aws provider from
# var.region and the acme provider from var.acme_server_url itself. AWS
# credentials come from the usual chain (AWS_PROFILE, env vars, SSO).
