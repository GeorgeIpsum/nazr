# Copy to .env to override compose defaults. Every line is commented out at its default;
# uncomment to change. Secrets are left blank. See docs/configuration.md.
# Compose-only: NAZR_VERSION sets the image tag / version string (default dev).
# NAZR_VERSION=dev

# PostgreSQL URL
# NAZR_DATABASE_URL=postgres://nazr:nazr@postgres:5432/nazr?sslmode=disable
# Optional Redis URL
# NAZR_REDIS_URL=
# Public listener address
# NAZR_LISTEN_ADDR=:443
# Plain-HTTP listener for ACME HTTP-01 and a 308 redirect to HTTPS
# NAZR_HTTP_ADDR=:80
# Prometheus /metrics listener; empty disables it
# NAZR_METRICS_ADDR=0.0.0.0:9090
# See connection modes
# NAZR_TLS_MODE=terminate
# Inline certificate chain (terminate mode)
# NAZR_TLS_CERT_PEM=
# Inline private key
# NAZR_TLS_KEY_PEM=
# Certificate file, reloaded on SIGHUP and every 12 hours
# NAZR_TLS_CERT_FILE=/certs/cert.pem
# Private key file
# NAZR_TLS_KEY_FILE=/certs/key.pem
# Domains for automatic Let's Encrypt certificates
# NAZR_ACME_DOMAINS=
# Contact address for the ACME account
# NAZR_ACME_EMAIL=
# Certificate cache directory
# NAZR_ACME_DIR=
# Read a PROXY protocol v2 header for the client address
# NAZR_PROXY_PROTOCOL=false
# Proxied mode: hops skipped when walking NAZR_CLIENT_IP_HEADER from the right
# NAZR_TRUSTED_PROXIES=
# Proxied mode: header carrying the client IP
# NAZR_CLIENT_IP_HEADER=x-forwarded-for
# Proxied mode: header carrying the JA4 computed by the proxy
# NAZR_JA4_HEADER=x-ja4
# Global CORS origins; used for preflight and as the baseline on real requests
# NAZR_CORS_ORIGINS=*
# Bearer token for /admin/keys
# NAZR_ADMIN_TOKEN=
# Requests per minute per key (overridable per key), and per IP on /beacon
# NAZR_DEFAULT_RATE_LIMIT=600
# Maximum request body size; larger bodies get 413
# NAZR_BODY_LIMIT=262144
# Cache for downloaded IP lists
# NAZR_DATA_DIR=/data
# Serve static files at /demo/ when set
# NAZR_DEMO_DIR=
# Apply database migrations on serve start
# NAZR_AUTO_MIGRATE=true
# debug, info, warn, error
# NAZR_LOG_LEVEL=info
# Log encoding
# NAZR_LOG_FORMAT=json
# MaxMind account ID
# NAZR_MAXMIND_ACCOUNT_ID=
# MaxMind license key
# NAZR_MAXMIND_LICENSE_KEY=
# Editions to download
# NAZR_MAXMIND_EDITIONS=GeoLite2-City,GeoLite2-ASN
# Override the Private Relay CSV URL
# NAZR_APPLE_RELAY_URL=
# Override the Tor exit list URL
# NAZR_TOR_EXIT_URL=
# Replace the datacenter CIDR lists
# NAZR_DATACENTER_URLS=
# Replace the VPN CIDR lists
# NAZR_VPN_URLS=
# FoxIO JA4 database URL
# NAZR_JA4DB_URL=
# Bearer token sent to NAZR_JA4DB_URL
# NAZR_JA4DB_TOKEN=
# Source names or kinds to skip entirely; see IP lists
# NAZR_LISTS_DISABLE=
# Sightings before a locally observed UA family counts for a JA4
# NAZR_UA_JA4_MIN_OBSERVATIONS=20
# Fraction of requests without a JA4 that receive a collect directive
# NAZR_COLLECT_SAMPLE_RATE=0.01
# How far back a thumbmark can be matched to an existing visitor
# NAZR_VISITOR_MATCH_WINDOW=720h
# Store the client IP as is, or only its salted hash
# NAZR_STORE_IP=raw
# Salt for ip_identifier (and stored hashes)
# NAZR_IP_HASH_SALT=
# Persist the full merged components with each event
# NAZR_STORE_COMPONENTS=false
# Events older than this are pruned hourly; 0 keeps them forever
# NAZR_EVENT_RETENTION=2160h
# Enables storing /log bodies and sets their retention; 0 discards them
# NAZR_LOG_RETENTION=0s
