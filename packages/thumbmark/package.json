{
    "name": "@nazr/thumbmark",
    "version": "0.1.0",
    "description": "Self-hostable browser fingerprinting client, a fork of ThumbmarkJS",
    "type": "module",
    "main": "./dist/thumbmark.cjs",
    "module": "./dist/thumbmark.esm.js",
    "types": "./dist/thumbmark.esm.d.ts",
    "exports": {
        ".": {
            "types": "./dist/thumbmark.esm.d.ts",
            "import": "./dist/thumbmark.esm.js",
            "require": "./dist/thumbmark.cjs"
        }
    },
    "public": true,
    "files": [
        "dist",
        "src/components/audio/index.ts",
        "src/components/canvas/index.ts",
        "src/components/fonts/index.ts",
        "src/components/hardware/index.ts",
        "src/components/locales/index.ts",
        "src/components/math/index.ts",
        "src/components/permissions/index.ts",
        "src/components/plugins/index.ts",
        "src/components/screen/index.ts",
        "src/components/speech/index.ts",
        "src/components/system/browser.ts",
        "src/components/system/index.ts",
        "src/components/webgl/index.ts",
        "src/components/webrtc/index.ts",
        "src/components/privacy/index.ts",
        "src/components/mediaqueries/index.ts",
        "src/components/clientrects/index.ts",
        "src/components/clienthints/index.ts",
        "src/components/webgpu/index.ts",
        "src/factory.ts",
        "src/functions/api.ts",
        "src/functions/filterComponents.ts",
        "src/functions/index.ts",
        "src/functions/legacy_functions.ts",
        "src/index.ts",
        "src/options.ts",
        "src/thumbmark.ts",
        "src/types/global.d.ts",
        "src/utils/cache.ts",
        "src/utils/collect.ts",
        "src/utils/commonPixels.ts",
        "src/utils/ephemeralIFrame.ts",
        "src/utils/getMostFrequent.ts",
        "src/utils/hash.ts",
        "src/utils/imageDataToDataURL.ts",
        "src/utils/log.ts",
        "src/utils/raceAll.ts",
        "src/utils/sort.ts",
        "src/utils/stableStringify.ts",
        "src/utils/version.ts",
        "src/utils/visitorId.ts"
    ],
    "scripts": {
        "build": "rm -rf dist/* && rm -rf types/* && rollup -c",
        "test": "jest",
        "test:e2e": "bash scripts/make-testpage.sh && playwright test",
        "upstream:diff": "bash scripts/upstream-diff.sh",
        "fixtures": "tsx scripts/gen-fixtures.ts",
        "lint": "biome check .",
        "typecheck": "tsc --noEmit -p tsconfig.test.json && tsc --noEmit -p tsconfig.scripts.json"
    },
    "keywords": [
        "thumbmark",
        "browser-thumbmarking",
        "browser-thumbmark",
        "thumbmarking",
        "fingerprint",
        "fingerprinting",
        "browser-fingerprint",
        "browser-fingerprinting",
        "audio-fingerprinting",
        "canvas-fingerprinting",
        "visitor-identifier",
        "fraud-detection"
    ],
    "author": "Ilkka Peltola",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/GeorgeIpsum/nazr.git",
        "directory": "packages/thumbmark"
    },
    "homepage": "https://github.com/GeorgeIpsum/nazr/tree/main/packages/thumbmark",
    "bugs": {
        "url": "https://github.com/GeorgeIpsum/nazr/issues"
    },
    "unpkg": "dist/thumbmark.umd.js",
    "devDependencies": {
        "@jest/globals": "^29.7.0",
        "@playwright/test": "^1.57.0",
        "@rollup/plugin-commonjs": "^25.0.7",
        "@rollup/plugin-json": "^6.1.0",
        "@rollup/plugin-node-resolve": "^15.2.3",
        "@rollup/plugin-terser": "^1.0.0",
        "@rollup/plugin-typescript": "^12.3.1",
        "@testing-library/jest-dom": "^6.1.6",
        "@types/jest": "^29.5.11",
        "@types/jsdom": "^21.1.6",
        "@types/node": "^20.10.6",
        "@types/ua-parser-js": "^0.7.39",
        "jest": "^29.7.0",
        "jest-environment-jsdom": "^29.7.0",
        "jsdom": "^23.0.1",
        "rollup": ">=4.22.4",
        "rollup-plugin-dts": "^6.1.0",
        "serve": "^14.2.5",
        "ts-jest": "^29.1.1",
        "ts-md5": "^1.3.1",
        "tslib": "^2.8.1",
        "tsx": "^4",
        "typescript": "^5.3.3"
    }
}
