{
  "$schema": "https://biomejs.dev/schemas/2.6.2/schema.json",
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "rules": {
      "preset": "recommended"
    }
  },
  "files": {
    "includes": [
      "**",
      "!packages/*/dist",
      "!apps/*/dist",
      "!packages/*/types",
      "!apps/*/types",
      "!**/node_modules",
      "!**/coverage",
      "!**/.turbo",
      "!deploy",
      "!docs",
      "!pnpm-lock.yaml",
      "!.superpowers",
      "!**/testpage",
      "!**/test-results",
      "!apps/api/testdata",
      "!apps/api/internal/widgetassets/assets",
      "!packages/jb"
    ]
  },
  "overrides": [
    {
      "includes": ["packages/thumbmark/**"],
      "formatter": {
        "indentWidth": 4
      },
      "linter": {
        "rules": {
          "suspicious": {
            "noExplicitAny": "off",
            "useIterableCallbackReturn": "off",
            "noFallthroughSwitchClause": "off",
            "noMisleadingInstantiator": "off",
            "noRedeclare": "off",
            "noPrototypeBuiltins": "off"
          },
          "security": {
            "noGlobalEval": "off"
          },
          "a11y": {
            "useButtonType": "off"
          }
        }
      }
    }
  ]
}
